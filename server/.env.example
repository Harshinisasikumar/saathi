# Saathi — server environment (all optional, defaults shown)
#
# These are read from the process environment. The server does not auto-load
# a .env file; export them in your shell or set them in your run command, e.g.
#   $env:PORT=8787; $env:ADMIN_PASS="change-me"; npm run dev

# Port the Express API listens on. Vite's dev proxy expects 8787.
PORT=8787

# MongoDB connection string. If unset (or unreachable) the API falls back to
# an in-memory store pre-seeded with demo sessions — ideal for the hackathon
# walkthrough.
MONGODB_URI=mongodb://127.0.0.1:27017/saathi

# Admin dashboard demo credentials.
ADMIN_USER=admin
ADMIN_PASS=saathi2024

# Set DEMO_MODE=false to suppress the demo-mode banner and warnings.
# Outcome figures are synthetic regardless; provenance stays "demo".
DEMO_MODE=true

# Allowed CORS origin. Use * (default) or a specific origin like
# http://localhost:5173
CORS_ORIGIN=*