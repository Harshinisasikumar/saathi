# Client build-time environment (optional).
# Copy to .env.local (dev) or export when building. Everything is optional.

# Absolute base URL of the Saathi API. When set, the built app calls the API
# cross-origin (the server allows CORS). When unset, the app calls same-origin
# /api (dev proxy, or the Express server serving the app).
VITE_API_URL=https://saathi.onrender.com

# Base path the app is served from. Use "" for a domain root (Vite default is
# "/"); use "/saathi/" when publishing to a GitHub Pages project site.
VITE_BASE_URL=